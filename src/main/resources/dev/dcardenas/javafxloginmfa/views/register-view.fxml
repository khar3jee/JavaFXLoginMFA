<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="380.0" prefWidth="585.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.dcardenas.javafxloginmfa.ui.RegisterController">
    <left>
    </left>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
   <bottom>
   </bottom>
   <center>
       <SplitPane dividerPositions="0.5" prefHeight="180" prefWidth="220" stylesheets="@../style.css" BorderPane.alignment="CENTER">
           <VBox alignment="CENTER" stylesheets="@../style.css">
               <ImageView fitHeight="180.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                   <image>
                       <Image url="@../../../images/fake_co_logo.svg.png" />
                   </image>
               </ImageView>
           </VBox>
           <VBox alignment="BOTTOM_CENTER" stylesheets="@../style.css">
               <Group VBox.vgrow="SOMETIMES">
                   <children>
                       <Label layoutY="3.0" text="First Name:" textAlignment="CENTER">
                           <font>
                               <Font name="System Bold" size="14.0" />
                           </font>
                       </Label>
                       <TextField fx:id="firstnameField" layoutX="74.0" prefHeight="25.0" prefWidth="105.0" promptText="First name">
                           <font>
                               <Font name="System Italic" size="12.0" />
                           </font>
                       </TextField>
                       <Label layoutY="36.0" text="Last Name:" textAlignment="CENTER">
                           <font>
                               <Font name="System Bold" size="14.0" />
                           </font>
                       </Label>
                       <TextField fx:id="lastnameField" layoutX="74.0" layoutY="33.0" prefHeight="25.0" prefWidth="105.0" promptText="Last name">
                           <font>
                               <Font name="System Italic" size="12.0" />
                           </font>
                       </TextField>
                       <Label layoutY="69.0" text="Username:" textAlignment="CENTER">
                           <font>
                               <Font name="System Bold" size="14.0" />
                           </font>
                       </Label>
                       <TextField fx:id="usernameField" layoutX="74.0" layoutY="66.0" prefHeight="25.0" prefWidth="105.0" promptText="Username">
                           <font>
                               <Font name="System Italic" size="12.0" />
                           </font>
                       </TextField>
                       <Label layoutX="12.0" layoutY="102.0" text="Email: " textAlignment="CENTER">
                           <font>
                               <Font name="System Bold" size="14.0" />
                           </font>
                       </Label>
                       <TextField fx:id="emailAddressField" layoutX="72.0" layoutY="99.0" prefHeight="25.0" prefWidth="105.0" promptText="Email Address">
                           <font>
                               <Font name="System Italic" size="12.0" />
                           </font>
                       </TextField>
                       <Label layoutX="1.0" layoutY="135.0" text="Password:" textAlignment="CENTER">
                           <font>
                               <Font name="System Bold" size="14.0" />
                           </font>
                       </Label>
                       <PasswordField fx:id="passwordField" layoutX="74.0" layoutY="132.0" prefHeight="25.0" prefWidth="105.0" promptText="Password">
                           <font>
                               <Font name="System Italic" size="12.0" />
                           </font>
                       </PasswordField>
                       <Button fx:id="registerUserButton" layoutX="18.0" layoutY="173.0" mnemonicParsing="false" onAction="#attemptUserRegistration" prefHeight="30.0" prefWidth="68.0" text="Register">
                           <font>
                               <Font name="System Bold" size="12.0" />
                           </font>
                       </Button>
                       <Button fx:id="backToLoginButton" accessibleText="Go Back" layoutX="104.0" layoutY="173.0" mnemonicParsing="false" onAction="#backToLogin" prefHeight="30.0" prefWidth="68.0" text="Go Back" textAlignment="CENTER">
                           <font>
                               <Font name="System Bold" size="12.0" />
                           </font>
                       </Button>
                   </children>
               </Group>
               <Label fx:id="registrationError" alignment="BOTTOM_CENTER" layoutX="17.0" layoutY="216.0" prefHeight="103.0" prefWidth="228.0" textAlignment="CENTER" wrapText="true" />
           </VBox>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
       </SplitPane>
   </center>
   <right>
   </right>
</BorderPane>
